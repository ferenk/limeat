# Hint: List ignored files: git status --ignored

# Default ignored files
/shelf/
/workspace.xml
# Editor-based HTTP Client requests
/httpRequests/
# Datasource local storage ignored files
/dataSources/
/dataSources.local.xml

# Application files
node_modules*
**/*.log
package-lock.json
tmp/
client_versions*

# IDE(A), tools configuration
.idea/
.vscode/
client/coverage

# Configuration files, secrets
app.env
**/*.dis[a-z]*
*.key.*

# Temporal/generated files
*.tmp
*.tmp.*
*.bak
*.dis
*.disabled*
*.d.*ts
*.js.map
*.tsbuildinfo
*log
*out
**/*quokka*.*js
dist/
.scannerwork/
/server/**/*.js
